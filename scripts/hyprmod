#!/bin/bash

# Script to modify Hyprland's $mainMod variable
# Usage: hyprmod <modifier>
# Example: hyprmod SUPER

if [ -z "$1" ]; then
    echo "Usage: hyprmod <modifier>"
    echo "Example: hyprmod SUPER"
    exit 1
fi

CONFIG_FILE="$HOME/.config/hypr/hyprland.conf"
NEW_MOD="$1"

if [ ! -f "$CONFIG_FILE" ]; then
    echo "Error: Hyprland config not found at $CONFIG_FILE"
    exit 1
fi

# Use sed to replace the $mainMod line
sed -i "s/^\$mainMod = .*$/\$mainMod = $NEW_MOD/" "$CONFIG_FILE"

echo "Updated \$mainMod to $NEW_MOD in $CONFIG_FILE"
