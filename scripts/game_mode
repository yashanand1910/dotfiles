#!/bin/bash

# Game mode script - toggles performance settings
# Usage: game_mode [on|off|true|false]

if [ $# -eq 0 ]; then
  echo "Usage: game_mode [on|off|true|false]"
  exit 1
fi

# Convert argument to lowercase
arg=$(echo "$1" | tr '[:upper:]' '[:lower:]')

case "$arg" in
on | true)
  echo "Enabling game mode..."
  # sudo -i tlp_gov_ac performance
  sudo -i gov performance
  # aggregate file keeps alienware-wmi and dell-pc in agreement
  echo balanced | sudo tee /sys/firmware/acpi/platform_profile >/dev/null
  # hyprmod SUPER
  echo "Game mode enabled: performance governor + balanced profile, SUPER mod key"
  ;;
off | false)
  echo "Disabling game mode..."
  # sudo -i tlp_gov_ac schedutil
  sudo -i gov powersave
  echo balanced | sudo tee /sys/firmware/acpi/platform_profile >/dev/null
  # hyprmod ALT
  echo "Game mode disabled: powersave governor + balanced profile, ALT mod key"
  ;;
*)
  echo "Invalid argument: $1"
  echo "Usage: game_mode [on|off|true|false]"
  exit 1
  ;;
esac
