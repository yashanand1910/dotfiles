#!/bin/bash

# Auto game mode: toggles game_mode (CPU governor) with Steam games.
# Listens on Hyprland's event socket; the first steam_app_* window to open
# turns game_mode on, the last one to close turns it off. Uses the same class
# marker as the steam_app windowrules — native Linux games that set their own
# class won't trigger either, so keep the two in sync.

GAME_CLASS='^(steam_app_[0-9]+|dota2|cs2)$'

if [ -z "$HYPRLAND_INSTANCE_SIGNATURE" ]; then
  export HYPRLAND_INSTANCE_SIGNATURE=$(ls -t "/run/user/$(id -u)/hypr" | head -1)
fi
RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
SOCKET="$RUNTIME_DIR/hypr/$HYPRLAND_INSTANCE_SIGNATURE/.socket2.sock"

# one instance per session
exec 9>"$RUNTIME_DIR/game_mode_auto.lock"
flock -n 9 || exit 0

games_running() {
  hyprctl clients -j |
    jq --arg re "$GAME_CLASS" '[.[] | select(.class | test($re))] | length'
}

state=""
reconcile() {
  local want=off
  [ "$(games_running)" -gt 0 ] && want=on
  [ "$want" = "$state" ] && return
  state=$want
  ~/code/scripts/game_mode "$want" >/dev/null 2>&1
  notify-send -a game_mode -t 3000 "Game mode $want" 2>/dev/null
}

reconcile
socat -u "UNIX-CONNECT:$SOCKET" - | while read -r line; do
  case "$line" in
  openwindow* | closewindow*) reconcile ;;
  esac
done
