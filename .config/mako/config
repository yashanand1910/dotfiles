font=Noto Sans 11
width=400
height=200
background-color=#00000055
border-size=2
border-radius=10
border-color=#ffffff22
padding=15
max-history=10
icon-location=right
max-visible=10
ignore-timeout=1
default-timeout=15000
sort=-time
icons=1
group-by=summary

[grouped]
format=<b>%s</b> (%g)\n%b

[urgency=critical]
default-timeout=0

[mode=do-not-disturb]
invisible=1
